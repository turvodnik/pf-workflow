#!/bin/bash
# Test double for the real `codex` CLI. NEVER the real thing. Behavior is
# selected entirely through env vars so one fixture file covers every
# scenario the harness needs. Talks to no network, no provider.

if [ -n "${FAKE_CODEX_ARGV_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_CODEX_ARGV_LOG"
fi
if [ -n "${FAKE_CODEX_CALL_LOG:-}" ]; then
  printf 'called\n' >> "$FAKE_CODEX_CALL_LOG"
fi

# I-033 (T-024): the double is now PROMPT-AWARE. A compliant model ends its
# output with the completion marker the prompt demands — and emits nothing of
# the sort when the prompt does not demand it. That single behaviour is what
# makes the negative control real: strip the requirement out of the SUT's
# prompt and every honest fixture below stops signing off, so the suite goes
# red. Without this, fixtures would emit the marker unconditionally and the
# "does the verdict actually depend on the marker" question could never be
# answered by the harness itself.
SENTINEL='CODEX-REVIEW-COMPLETE'
sentinel_demanded() {
  case "$*" in *"$SENTINEL"*) return 0 ;; esac
  return 1
}
# emit_sentinel <n> — the marker, exactly as a compliant model would write it.
emit_sentinel() {
  sentinel_demanded "$ARGV_ALL" || return 0
  printf '%s: %s\n' "$SENTINEL" "$1"
}
ARGV_ALL="$*"

case "${FAKE_CODEX_MODE:-success}" in
  success)
    printf -- '- [P2] fake finding — fixtures/example.sh:1\n    because the test says so\n'
    emit_sentinel 1
    exit 0 ;;
  clean)
    printf 'Reviewed the diff. No problems found.\n'
    emit_sentinel 0
    exit 0 ;;
  clean-security-prose)
    # I-022 repro: a genuine, clean review of auth/rate-limit code — long,
    # structured prose that legitimately uses the same words F-09's
    # signature watches for. Must NOT be reclassified as a provider failure.
    printf 'Reviewed the diff across 4 files focused on the new auth middleware.\n\n'
    printf 'Summary:\nThe middleware correctly rejects a request when authentication failed\n'
    printf 'upstream, returning 401 without leaking details. It also enforces a rate\n'
    printf 'limit of 100 requests per minute per API key, and the counter resets on\n'
    printf 'schedule as expected under the added tests.\n\n'
    printf 'No problems found. This review is complete.\n'
    emit_sentinel 0
    exit 0 ;;
  error-rc0)
    # F-09 repro: provider-side failure text on stdout, CLI itself exits 0.
    printf 'authentication failed: provider returned an error page\n'
    exit 0 ;;
  traceback)
    # I-031 repro: a real Python traceback, 6 lines / 281 bytes — over the
    # length-only F-09 threshold (ERR_SHAPE_LINES=3 / ERR_SHAPE_CHARS=300),
    # so the length gate alone waves it through as "0 findings, clean".
    printf 'Traceback (most recent call last):\n'
    printf '  File "/app/provider_client.py", line 142, in call\n'
    printf '    resp = self._session.post(url, json=payload, timeout=30)\n'
    printf '  File "/usr/lib/python3.11/site-packages/requests/sessions.py", line 637, in post\n'
    printf '    return self.request("POST", url, data=data, json=json, **kwargs)\n'
    printf 'requests.exceptions.ConnectionError: HTTPSConnectionPool: Max retries exceeded\n'
    exit 0 ;;
  html-error)
    # I-031 repro: an HTML error page, 8 lines / 185 bytes — also over the
    # length-only threshold.
    printf '<!DOCTYPE html>\n<html>\n<head><title>502 Bad Gateway</title></head>\n'
    printf '<body>\n<center><h1>502 Bad Gateway</h1></center>\n'
    printf '<hr><center>nginx</center>\n</body>\n</html>\n'
    exit 0 ;;
  html-error-minified)
    # I-031 repro: the same page collapsed to one line, padded past
    # ERR_SHAPE_CHARS (300) on purpose — this is the exact shape the T-023
    # gate measured (343 bytes) slipping through on length alone. Padded
    # with digits (not another failure word) so this case actually
    # exercises the structural, length-independent detector and is not
    # incidentally caught by the length-gated FAILURE_SIGNATURE word list
    # too, which would make it a weaker regression guard.
    _html='<!DOCTYPE html><html><head><title>502 Bad Gateway</title></head><body><center><h1>502 Bad Gateway</h1></center><hr><center>nginx/1.24.0</center></body></html><!-- trace id '
    printf -v _pad '%*s' 130 ''
    printf '%s%s -->\n' "$_html" "${_pad// /0}"
    exit 0 ;;
  clean-quotes-traceback)
    # I-031 regression guard: a genuine, clean, structured review whose
    # prose discusses error handling and QUOTES a traceback line/HTML tag
    # as an example, but does not itself begin with one. Must stay OK — the
    # trap named in T-023: "no [P1]/[P2]/[P3] markers -> not a report" is
    # false, an honest clean review has none by definition.
    printf 'Reviewed the diff across 3 files covering the retry wrapper around the\n'
    printf 'provider client.\n\n'
    printf 'Summary:\nThe wrapper catches the case where the upstream call raises an error\n'
    printf 'whose repr starts with "Traceback (most recent call last):" and logs it\n'
    printf 'at WARNING before retrying, which matches the existing test fixtures.\n\n'
    printf 'No problems found. This review is complete.\n'
    emit_sentinel 0
    exit 0 ;;
  clean-quotes-html)
    printf 'Reviewed the diff across 2 files covering the error-page renderer.\n\n'
    printf 'Summary:\nWhen the upstream 5xx bubbles up, the handler wraps the body in a\n'
    printf 'minimal template beginning with `<!DOCTYPE html><html>...` before\n'
    printf 'sending it back to the caller, and unit tests assert on that literal\n'
    printf 'prefix. Error mapping otherwise matches the existing 4xx/5xx table.\n\n'
    printf 'No problems found. This review is complete.\n'
    emit_sentinel 0
    exit 0 ;;
  clean-quotes-json-error)
    printf 'Reviewed the diff across 2 files covering the JSON error envelope.\n\n'
    printf 'Summary:\nOn failure the API now serializes the standard `{"error": ...}`\n'
    printf 'envelope with a stable "code" field, matching the schema the client\n'
    printf 'already expects, and the added tests cover the 4xx/5xx boundary.\n\n'
    printf 'No problems found. This review is complete.\n'
    emit_sentinel 0
    exit 0 ;;
  boundary-chars-at)
    # T-023 gate hygiene: pin the ERR_SHAPE_CHARS boundary itself, not just
    # a fixture that clears it with room to spare. Exactly ERR_SHAPE_CHARS
    # (300) bytes total, one line, matches the word signature -> must FAIL.
    # If ERR_SHAPE_CHARS is ever raised without noticing, this case alone
    # won't catch it (it would still be <= a larger threshold) but its
    # boundary-chars-over sibling below will.
    # Builds the padding with bash builtins only (printf -v + parameter
    # expansion) — `seq` is deliberately absent from the curated test PATH
    # (F-11's BASE_TOOLS) and this fixture must run under it.
    printf -v _pad '%*s' 276 ''
    printf 'authentication failed: %s\n' "${_pad// /x}"
    exit 0 ;;
  boundary-chars-over)
    # One byte past ERR_SHAPE_CHARS (301), same single line, same word
    # signature -> must NOT fail on length alone (word-signature path is
    # gated out); still not a structural match either -> OK.
    printf -v _pad '%*s' 277 ''
    printf 'authentication failed: %s\n' "${_pad// /x}"
    exit 0 ;;
  # --- I-033 (T-024): honest reviews that sign off with the marker ----------
  clean-oneline)
    # The shortest possible honest review: nothing but the sign-off. Under the
    # old length heuristics this was the most "suspicious" shape there is;
    # under the success contract it is fully proven. (With the requirement
    # removed from the prompt it emits nothing at all -> empty -> FAIL, which
    # is exactly what the negative control expects.)
    emit_sentinel 0
    exit 0 ;;
  findings-multi)
    printf -- '- [P1] fake blocker — fixtures/example.sh:10\n    explanation\n'
    printf -- '- [P2] fake defect — fixtures/example.sh:20\n    explanation\n'
    printf -- '- [P3] fake nit — fixtures/example.sh:30\n    explanation\n'
    emit_sentinel 3
    exit 0 ;;
  # --- I-033: broken sign-offs ---------------------------------------------
  sentinel-count-mismatch)
    # One finding, a sign-off claiming three: the report and its own marker
    # disagree, which is what a truncated middle looks like. Written literally
    # (not through emit_sentinel) — this fixture is about a WRONG marker, and
    # it must behave the same whether or not the prompt asked for one.
    printf -- '- [P2] fake finding — fixtures/example.sh:1\n    explanation\n'
    printf 'CODEX-REVIEW-COMPLETE: 3\n'
    exit 0 ;;
  truncated-marker)
    # The tail was cut mid-marker: two real findings, then the sign-off breaks
    # off in the middle of the token, with no trailing newline. Must FAIL even
    # though well-formed finding lines are present — a corrupted marker is
    # stronger evidence of truncation than findings are of completeness.
    printf -- '- [P1] fake blocker — fixtures/example.sh:10\n    explanation\n'
    printf -- '- [P2] fake defect — fixtures/example.sh:20\n    explanation\n'
    printf 'CODEX-REVIEW-COMPL'
    exit 0 ;;
  clean-no-marker)
    # An honest-looking clean review by a model that ignored the requirement.
    # Never emits the marker, whatever the prompt says.
    printf 'Reviewed the diff across 3 files.\n\nNo problems found.\n'
    exit 0 ;;
  findings-no-marker)
    # Same disobedience, but with findings: the backup proof of "this is a
    # report" (well-formed finding lines) must accept it, loudly.
    printf -- '- [P1] fake blocker — fixtures/example.sh:10\n    explanation\n'
    printf -- '- [P2] fake defect — fixtures/example.sh:20\n    explanation\n'
    exit 0 ;;
  # --- T-024 gate: attacks on the BACKUP branch itself ---------------------
  # A provider failure that happens to carry a well-formed finding line inside
  # it. These are emitted unconditionally (a failing provider never reads our
  # prompt), and they are the two shapes the gate used to walk straight past
  # the backup proof into "OK + NOTE". The finding line is what makes them
  # dangerous; the known failure shape around it is what must now veto them.
  gate-html-with-finding)
    printf '<!DOCTYPE html>\n<html>\n<head><title>502 Bad Gateway</title></head>\n<body>\n'
    printf '<h1>502 Bad Gateway</h1>\n<pre>\n'
    printf -- '- [P1] Internal renderer error — example.sh:1-2\n'
    printf '</pre>\n</body>\n</html>\n'
    exit 0 ;;
  gate-json-with-finding)
    printf '{"error": {"code": "context_length_exceeded", "message": "the request\n'
    printf 'exceeded the model context window", "request_id": "req_00000043"}}\n'
    printf -- '- [P2] unchecked exit code — example.sh:3\n'
    exit 0 ;;
  # --- T-024 gate: truncation inside the first characters of the token -----
  # The old 8-character floor made these invisible: a cut after 1..7 characters
  # left a fragment too short to be checked, so the run was accepted on the
  # backup proof instead of failing as truncated.
  truncated-marker-1)
    printf -- '- [P2] fake finding — fixtures/example.sh:1\n    explanation\n'
    printf 'C'
    exit 0 ;;
  truncated-marker-7)
    printf -- '- [P2] fake finding — fixtures/example.sh:1\n    explanation\n'
    printf 'CODEX-R'
    exit 0 ;;
  # --- T-024 gate: an obedient marker in markdown clothing -----------------
  # The likeliest real-model deviation. The marker is there and correct; only
  # its wrapper differs, so these must read as honest sign-offs.
  marker-bold)
    printf -- '- [P2] fake finding — fixtures/example.sh:1\n    explanation\n'
    sentinel_demanded "$ARGV_ALL" && printf '**%s: 1**\n' "$SENTINEL"
    exit 0 ;;
  marker-backticks)
    printf 'Reviewed the diff. No problems found.\n'
    sentinel_demanded "$ARGV_ALL" && printf '`%s: 0`\n' "$SENTINEL"
    exit 0 ;;
  marker-underscores)
    printf 'Reviewed the diff. No problems found.\n'
    sentinel_demanded "$ARGV_ALL" && printf '_%s: 0_\n' "$SENTINEL"
    exit 0 ;;
  marker-leading-zero)
    # `: 01` for one finding — the model's formatting, not a different count.
    printf -- '- [P2] fake finding — fixtures/example.sh:1\n    explanation\n'
    sentinel_demanded "$ARGV_ALL" && printf '%s: 01\n' "$SENTINEL"
    exit 0 ;;
  marker-lowercase)
    # Not the contract token: still FAIL, but the message must say why.
    printf 'Reviewed the diff. No problems found.\n'
    sentinel_demanded "$ARGV_ALL" && printf 'codex-review-complete: 0\n'
    exit 0 ;;
  # --- I-033: the ten provider-failure shapes measured by the T-023 gate ----
  # Every one of them: exit 0, no marker, and (except where the table itself
  # noted otherwise) long enough that the old length gate could not save us.
  # None contains a well-formed finding line, so the backup proof cannot
  # rescue them either. They are here to prove one thing: a whitelist catches
  # all ten WITHOUT a single detector written for their shapes.
  t024-form-01)
    printf 'Error occurred while contacting provider:\n'
    printf 'Traceback (most recent call last):\n'
    printf '  File "/app/provider_client.py", line 142, in call\n'
    printf '    resp = self._session.post(url, json=payload, timeout=30)\n'
    printf 'requests.exceptions.ConnectionError: HTTPSConnectionPool: Max retries exceeded\n'
    exit 0 ;;
  t024-form-02)
    printf 'codex-cli 1.0.6\n\n'
    printf '<!DOCTYPE html>\n<html>\n<head><title>502 Bad Gateway</title></head>\n'
    printf '<body>\n<center><h1>502 Bad Gateway</h1></center>\n</body>\n</html>\n'
    exit 0 ;;
  t024-form-03)
    printf 'provider response:\n'
    printf '{"error": {"code": "upstream_unavailable", "message": "the model backend is\n'
    printf 'temporarily unavailable, retry later", "request_id": "req_0000000000000042"}}\n'
    printf 'no review was produced for this request\n'
    exit 0 ;;
  t024-form-04)
    printf -- '---\n'
    printf 'Traceback (most recent call last):\n'
    printf '  File "/app/provider_client.py", line 142, in call\n'
    printf '    resp = self._session.post(url, json=payload, timeout=30)\n'
    printf 'requests.exceptions.ConnectionError: HTTPSConnectionPool: Max retries exceeded\n'
    exit 0 ;;
  t024-form-05)
    printf 'Reviewing 3 files...\n'
    _i=1
    while [ "$_i" -le 18 ]; do
      printf 'internal dump line %s: state=partial buffer=0x%s handler=stream\n' "$_i" "$_i"
      _i=$(( _i + 1 ))
    done
    exit 0 ;;
  t024-form-06)
    # ANSI-coloured traceback: the escape sequence sits before the very first
    # visible character, which is precisely what defeated the position-anchored
    # structural detector.
    printf '\033[31mTraceback (most recent call last):\033[0m\n'
    printf '  File "/app/provider_client.py", line 142, in call\n'
    printf '    resp = self._session.post(url, json=payload, timeout=30)\n'
    printf '\033[31mrequests.exceptions.ConnectionError: HTTPSConnectionPool: Max retries exceeded\033[0m\n'
    exit 0 ;;
  t024-form-07)
    # A line of spaces first: non-empty, so it IS the first line, and it
    # matches nothing.
    printf '     \n'
    printf 'Traceback (most recent call last):\n'
    printf '  File "/app/provider_client.py", line 142, in call\n'
    printf '    resp = self._session.post(url, json=payload, timeout=30)\n'
    printf 'requests.exceptions.ConnectionError: HTTPSConnectionPool: Max retries exceeded\n'
    exit 0 ;;
  t024-form-08)
    printf '\n\n\n'
    printf '<!DOCTYPE html>\n<html>\n<head><title>502 Bad Gateway</title></head>\n'
    printf '<body>\n<center><h1>502 Bad Gateway</h1></center>\n</body>\n</html>\n'
    exit 0 ;;
  t024-form-09)
    printf '  {"error": {"code": "upstream_unavailable", "message": "the model backend\n'
    printf '  is temporarily unavailable, retry later", "request_id": "req_00000042"}}\n'
    printf '  no review was produced for this request\n'
    exit 0 ;;
  t024-form-10)
    printf 'HTTP/1.1 502 Bad Gateway\n'
    printf 'Server: nginx/1.24.0\nContent-Type: text/html\nContent-Length: 150\n'
    printf '\n<html><head><title>502 Bad Gateway</title></head><body></body></html>\n'
    exit 0 ;;
  empty)
    exit 0 ;;
  crash)
    printf 'boom\n' >&2
    exit 1 ;;
  hang)
    # Never exits by itself. No trap: a group-wide TERM kills it like any
    # ordinary process (this is the "leader dies normally" half of F-11).
    while true; do sleep 1; done ;;
  grandchild-survives-term)
    # F-11 repro: fork a detached descendant that ignores SIGTERM and record
    # its PID, then the leader itself behaves like plain "hang" (dies on a
    # group-wide TERM, same as above).
    # $BASHPID (the subshell's own PID) is bash 4+; this fixture must run
    # under bash 3.2 (macOS system /bin/bash, what `env bash` resolves to
    # here). $! read by the PARENT right after backgrounding is portable.
    ( trap '' TERM
      while true; do sleep 1; done ) &
    GC_PID=$!
    printf '%s\n' "$GC_PID" > "$FAKE_CODEX_GRANDCHILD_PID_FILE"
    disown "$GC_PID" 2>/dev/null || true
    while true; do sleep 1; done ;;
  *)
    echo "fake-codex: unknown FAKE_CODEX_MODE '${FAKE_CODEX_MODE:-}'" >&2
    exit 99 ;;
esac
