#!/usr/bin/env bash
# fake-secret-scan — stand-in for _tools/security/repo-hooks/pre-commit in
# tests/council.sh (T-171): red when a staged file holds the GitHub-token
# prefix, else green. Like the real scanner it names coordinates, never values.
# A scan of council.sh's final-message check (Ж-6) runs in a throwaway repo
# named msgscan-*: logged apart, so "the index scan ran / never ran" stays exact.
case "$PWD" in */msgscan-*) echo msgscan >> "${STUB_CTL:?}/msgscan-calls" ;; *) echo scan >> "${STUB_CTL:?}/scan-calls" ;; esac
pfx="gh""p_"; hit=0
for f in $(git diff --cached --name-only); do
  if git show ":$f" 2>/dev/null | grep -q "$pfx"; then echo "✗ $f:1 [pf-github-token]"; hit=1; fi
done
# Like the real scanner, the ledger is read from disk: a "suppress-all" line
# (stub syntax) silences every finding — what an agent-made ledger would do.
[ "$hit" = 1 ] && [ -f .agents/security/false-positives.yaml ] && grep -q suppress-all .agents/security/false-positives.yaml && hit=0
[ "$hit" = 0 ] && { echo "✓ секрет-скан: чисто"; exit 0; }
echo "✗ секрет-скан НЕ пройден"; exit 1
